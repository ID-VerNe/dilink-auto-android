*.iml
.gradle
/local.properties
/.idea
/.agents
/.handoffs
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
/app-client/build
/app-server/build
/protocol/build
session-log*.txt
/vd-server/build
/app-desktop/build
/protocol-core/build

# Built assets (generated by build, not source)
app-client/src/main/assets/app-server.apk
app-client/src/main/assets/vd-server.jar
app-server/src/main/assets/vd-server.jar

# Claude settings
.claude/

# WorkBuddy agent working memory (local only)
.workbuddy/

# IDE
.vscode/

# Release signing (passwords in properties)
signing.properties
keystore.properties

# Release signing key material (audit B-01): the keystore was committed in
# history and is now treated as compromised — never track it again. The new
# key lives only in CI secrets.
*.keystore
*.jks
*.p12

# Local test artifacts and logs (explicit, not just extension globs, so a
# stray `git add -A` cannot promote them — audit B-10)
*.apk
*.idsig
*.zip
*.log
.plan/
app-client/DiLinkAuto/
/debug-logs/
/apk-backup/
/DiLinkAuto-*.apk
/dilinkauto-logs*.zip
/session-log*.txt

# Vendored third-party sources mistakenly checked in (audit B-09)
/org/

# Agent scratch state (was only ignored via .git/info/exclude — audit B-I3)
.freebuff/

# Python bytecode cache (explore.py 等)
__pycache__/
*.pyc

# E2E harness 偶发在仓库根写出的快照（正常产物在 debug-logs/e2e/<TS>/ 下）
/vdlog.snapshot

# E2E 本地凭据（PIN 禁落仓库 — docs/e2e-dual-device-runbook.md §6 红线 8）。
# 只存本机、供 scripts/e2e.sh 无人值守加载；被 git 跟踪时脚本会直接拒绝运行。
/.e2e.local.env
